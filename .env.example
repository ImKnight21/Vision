# ============================================================
#  Vision — environment template.  Copy to .env and fill in.
#  .env is git-ignored; never commit real keys.
# ============================================================

# --- Backend ---
VISION_HOST=127.0.0.1
VISION_PORT=8000
VISION_CORS_ORIGINS=http://localhost:5173

# Cache time-to-live in seconds, per data class.
VISION_TTL_MARKETS=60
VISION_TTL_OHLCV=120
VISION_TTL_META=3600

# --- Data sources (all optional: public endpoints need no key) ---
# CoinGecko demo key raises the free rate limit. https://coingecko.com/en/api
COINGECKO_API_KEY=
# CryptoCompare fallback. https://cryptocompare.com
CRYPTOCOMPARE_API_KEY=

# --- Image generation (polza.ai, OpenRouter-style aggregator) ---
POLZA_API_KEY=
POLZA_BASE_URL=https://api.polza.ai/api/v1
POLZA_IMAGE_MODEL=

# --- Frontend (Vite only exposes VITE_* to the browser) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
