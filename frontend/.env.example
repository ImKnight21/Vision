# ============================================================
#  Frontend environment. Copy to frontend/.env to use.
#
#  Vite reads .env from THIS directory, not the repo root, and
#  only exposes VITE_-prefixed variables to the browser.
# ============================================================

# Where the dev server proxies /api. Leave unset to use the default below.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# In production this stays EMPTY. Netlify proxies /api/* to the backend
# (see netlify.toml), so the app calls its own origin and needs no base URL.
# Setting it makes the browser call the backend directly, which then requires
# VISION_CORS_ORIGINS on the backend to name this site.
