# ============================================================
#  Vision — environment template.  Copy to .env and fill in.
#  .env is git-ignored; never commit real keys.
# ============================================================

# --- Backend ---
VISION_HOST=127.0.0.1
VISION_PORT=8000
VISION_CORS_ORIGINS=http://localhost:5173

# Cache time-to-live in seconds, per data class.
VISION_TTL_MARKETS=60
VISION_TTL_OHLCV=120
VISION_TTL_META=3600

# --- Data sources (all optional: public endpoints need no key) ---
# CoinGecko demo key raises the free rate limit. https://coingecko.com/en/api
COINGECKO_API_KEY=
# CryptoCompare, the last fallback. It answers 401 without a key, so it is
# inert unless this is set. Binance and Bybit cover the chain without it.
# https://cryptocompare.com
CRYPTOCOMPARE_API_KEY=

# --- Image generation (polza.ai, OpenRouter-style aggregator) ---
# Used only by scripts/generate_assets.py; the app itself never calls it.
# Run `python scripts/generate_assets.py --list` for models and current prices.
POLZA_API_KEY=
POLZA_BASE_URL=https://api.polza.ai/api/v1
# Cheapest usable default is tongyi-mai/z-image (1.4 RUB/image).
# For type or logo work prefer openai/gpt-image-1.5 or black-forest-labs/flux.2-pro.
POLZA_IMAGE_MODEL=

# --- Frontend ---
# Vite reads its own .env from the frontend/ directory, not from here.
# See frontend/.env.example.
